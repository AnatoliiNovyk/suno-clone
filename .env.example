# =============================================================================
# suno-clone — environment template
# =============================================================================
# Copy to `.env` in the REPO ROOT and fill in the values:
#
#     cp .env.example .env
#
# One file serves all three parts of the stack: Vite loads it through
# `envDir: '..'` in suno-clone/vite.config.ts, the Python service through
# `load_dotenv("../.env")`, and the edge functions through
# `supabase functions serve --env-file ../.env`.
#
# Never commit `.env` itself — only this template is tracked.
# =============================================================================

# --- Supabase project --------------------------------------------------------
# Dashboard → Project Settings → API. The anon key is public by design; the
# service-role key bypasses RLS and must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same project, exposed to the frontend bundle. VITE_* values are shipped to
# the browser — put nothing secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Generation --------------------------------------------------------------
# Where the frontend sends generation requests. In production this must point
# at the deployed Python service, not localhost.
VITE_GENERATE_API_URL=http://localhost:8000

# Google AI key with access to `lyria-3-pro-preview` / `lyria-3-clip-preview`.
# A key without access still costs the user credits (they are refunded when the
# generation fails).
GOOGLE_AI_API_KEY=

# Comma-separated origins allowed to call the Python service, or `*` for
# wide-open (development only — `*` disables credentialed CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# --- Python service tuning (optional) ----------------------------------------
# How long an in-flight track may sit untouched before the reaper fails and
# refunds it. Must stay above the worst-case generation time (~20 min).
GENERATION_STUCK_AFTER_SECONDS=1800
# How often the reaper sweeps.
GENERATION_REAPER_INTERVAL_SECONDS=300
# Set to 1 to boot with an incomplete configuration and report "degraded" on
# GET / instead of refusing to start. Off by default so a bad deploy fails loudly.
ALLOW_DEGRADED_START=

# --- Edge functions ----------------------------------------------------------
# Public site URL, used to build payment success/cancel redirects.
SITE_URL=http://localhost:5173
# Only for the legacy `generate-music` proxy function; the frontend calls the
# Python service directly.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# --- Payments ----------------------------------------------------------------
# Payments stay inactive until at least one provider is configured.
# Stripe (USD/EUR). The webhook endpoint must have `invoice.paid` enabled —
# without it subscription renewals never grant credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LiqPay (UAH/USD/EUR).
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Accept LiqPay `sandbox` (test) payments as real ones. Leave empty in
# production: a sandbox payment moves no money but would grant a full plan.
LIQPAY_ALLOW_SANDBOX=

# --- Tooling (optional) ------------------------------------------------------
# Personal access token for the Supabase CLI (`supabase login` writes its own).
SUPABASE_ACCESS_TOKEN=
