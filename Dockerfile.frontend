FROM node:22-alpine AS build

WORKDIR /app/suno-clone

COPY suno-clone/package.json suno-clone/pnpm-lock.yaml suno-clone/pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

COPY suno-clone/ ./

# These values are public and are embedded in the Vite bundle. Never add
# service-role, payment-provider, or Google AI secrets as build arguments.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_GENERATE_API_URL=/api
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_GENERATE_API_URL=$VITE_GENERATE_API_URL

RUN pnpm build:prod

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/suno-clone/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
